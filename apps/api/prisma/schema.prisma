generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  displayName     String
  createdAt       DateTime  @default(now())

  refreshTokens RefreshToken[]
  emailTokens   EmailToken[]
  devices       Device[]
  actionLogs    ActionLog[]
}

model RefreshToken {
  id           String    @id @db.Uuid
  userId       String    @db.Uuid
  deviceId     String?   @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([userId])
}

enum EmailTokenKind {
  VERIFY
  RESET
}

model EmailToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  kind      EmailTokenKind
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Device {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  platform   String
  model      String
  appVersion String
  name       String
  lastSeenAt DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  actionLogs    ActionLog[]

  // No stable hardware id from the app: one row per user + platform + model.
  @@unique([userId, platform, model])
}

model ActionLog {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @db.Uuid
  deviceId   String?  @db.Uuid
  platform   String
  device     String
  appVersion String
  action     String
  status     Int
  createdAt  DateTime @default(now())

  user User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  dev  Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
