generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  displayName     String
  publicInfo      Json      @default("{}")
  friendsInfo     Json      @default("{}")
  privateInfo     Json      @default("{}")
  musicPrefs      String[]  @default([])
  createdAt       DateTime  @default(now())

  refreshTokens RefreshToken[]
  emailTokens   EmailToken[]
  devices       Device[]
  actionLogs    ActionLog[]
  socialLinks   SocialAccount[]
  friendshipsA  Friendship[]   @relation("friendA")
  friendshipsB  Friendship[]   @relation("friendB")
  events        Event[]
  eventInvites  EventInvite[]
  suggestions   EventTrack[]
  votes         Vote[]
  playlists     Playlist[]
  memberships   PlaylistMember[]
  playlistAdds  PlaylistEntry[]

  @@index([displayName])
}

enum Provider {
  google
  facebook
}

model SocialAccount {
  provider   Provider
  providerId String
  userId     String   @db.Uuid
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerId])
  // One account per provider per user.
  @@unique([userId, provider])
}

model RefreshToken {
  id           String    @id @db.Uuid
  userId       String    @db.Uuid
  deviceId     String?   @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([userId])
}

enum EmailTokenKind {
  VERIFY
  RESET
}

model EmailToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  kind      EmailTokenKind
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Device {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  platform   String
  model      String
  appVersion String
  name       String
  lastSeenAt DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  actionLogs    ActionLog[]

  // No stable hardware id from the app: one row per user + platform + model.
  @@unique([userId, platform, model])
}

model ActionLog {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @db.Uuid
  deviceId   String?  @db.Uuid
  platform   String
  device     String
  appVersion String
  action     String
  status     Int
  createdAt  DateTime @default(now())

  user User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  dev  Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// One row per pair, ids ordered (userAId < userBId): no duplicate in either direction.
model Friendship {
  userAId     String           @db.Uuid
  userBId     String           @db.Uuid
  requesterId String           @db.Uuid
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  userA User @relation("friendA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("friendB", fields: [userBId], references: [id], onDelete: Cascade)

  @@id([userAId, userBId])
  @@index([userBId])
}

// Snapshot of a Deezer track, keyed by its Deezer id.
model Track {
  deezerId    Int      @id
  title       String
  artist      String
  album       String
  coverUrl    String?
  previewUrl  String?
  durationSec Int
  updatedAt   DateTime @updatedAt

  eventEntries    EventTrack[]
  playlistEntries PlaylistEntry[]
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum VoteLicense {
  EVERYONE
  INVITED
  LOCATION
}

model Event {
  id               String      @id @default(uuid()) @db.Uuid
  ownerId          String      @db.Uuid
  name             String
  visibility       Visibility  @default(PUBLIC)
  voteLicense      VoteLicense @default(EVERYONE)
  lat              Float?
  lng              Float?
  radiusM          Int?
  voteStartsAt     DateTime?
  voteEndsAt       DateTime?
  currentEntryId   String?     @db.Uuid
  currentStartedAt DateTime?
  version          Int         @default(0)
  createdAt        DateTime    @default(now())

  owner   User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  invites EventInvite[]
  entries EventTrack[]

  @@index([ownerId])
  @@index([visibility, createdAt])
}

model EventInvite {
  eventId   String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
}

// A suggested track. Leaves the queue (playedAt set) when it starts playing.
// The migration adds a partial unique index: one live entry per track and event.
model EventTrack {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @db.Uuid
  trackId       Int
  suggestedById String    @db.Uuid
  createdAt     DateTime  @default(now())
  playedAt      DateTime?

  event       Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  track       Track  @relation(fields: [trackId], references: [deezerId])
  suggestedBy User   @relation(fields: [suggestedById], references: [id], onDelete: Cascade)
  votes       Vote[]

  @@index([eventId, playedAt])
}

// The primary key makes a double vote impossible.
model Vote {
  eventTrackId String   @db.Uuid
  userId       String   @db.Uuid
  createdAt    DateTime @default(now())

  entry EventTrack @relation(fields: [eventTrackId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventTrackId, userId])
}

enum EditLicense {
  EVERYONE
  INVITED
}

model Playlist {
  id          String      @id @default(uuid()) @db.Uuid
  ownerId     String      @db.Uuid
  name        String
  visibility  Visibility  @default(PUBLIC)
  editLicense EditLicense @default(EVERYONE)
  version     Int         @default(0)
  createdAt   DateTime    @default(now())

  owner   User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members PlaylistMember[]
  entries PlaylistEntry[]

  @@index([ownerId])
  @@index([visibility, createdAt])
}

model PlaylistMember {
  playlistId String   @db.Uuid
  userId     String   @db.Uuid
  createdAt  DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([playlistId, userId])
  @@index([userId])
}

// position: fractional index; the migration sets COLLATE "C" so it sorts byte by byte.
model PlaylistEntry {
  id         String   @id @default(uuid()) @db.Uuid
  playlistId String   @db.Uuid
  trackId    Int
  position   String
  addedById  String   @db.Uuid
  createdAt  DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [deezerId])
  addedBy  User     @relation(fields: [addedById], references: [id], onDelete: Cascade)

  @@unique([playlistId, position])
}
