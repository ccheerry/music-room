{
	"cli": {
		"version": ">= 16.0.0",
		"appVersionSource": "local"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"environment": "development",
			"ios": { "resourceClass": "default" },
			"android": { "buildType": "apk" }
		},
		"development-simulator": {
			"extends": "development",
			"ios": { "simulator": true }
		}
	}
}
