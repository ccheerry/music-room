{
	"name": "music-room",
	"private": true,
	"engines": {
		"node": ">=22"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"allowScripts": {
		"esbuild@0.28.2": true,
		"prisma@7.10.1": true,
		"@prisma/engines@7.10.1": true,
		"argon2@0.45.1": true,
		"@parcel/watcher@2.6.0": true,
		"unrs-resolver@1.12.2": true,
		"@playwright/browser-chromium": false,
		"protobufjs": false,
		"unix-dgram": false
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"artillery": "^2.0.34",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-react-hooks": "^7.1.1",
		"prettier": "^3.9.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0"
	},
	"scripts": {
		"lint": "eslint . && npm run prettier -- --check",
		"format": "npm run prettier -- --write",
		"prettier": "prettier . --ignore-path .prettierignore --ignore-path .gitignore --ignore-path .git/info/exclude"
	},
	"overrides": {
		"react": "19.3.0",
		"react-dom": "19.3.0"
	}
}
