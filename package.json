		"prisma@7.10.1": true,
		"@prisma/engines@7.10.1": true
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"prettier": "^3.9.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0"
	},
	"scripts": {
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write ."
