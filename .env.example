# Copy to .env (git-ignored). The API refuses to start if a required variable is missing.

# --- Postgres (docker compose) ---
POSTGRES_USER=musicroom
POSTGRES_PASSWORD=musicroom
POSTGRES_DB=musicroom

# --- API ---
# Host-side URL (make dev / migrate / test). Inside compose the api uses the `postgres` host.
DATABASE_URL=postgresql://musicroom:musicroom@localhost:5432/musicroom
PORT=3000
LOG_LEVEL=info
# Signs access tokens, at least 32 characters. Generate one: openssl rand -base64 48
JWT_SECRET=dev-only-secret-replace-me-with-openssl-rand

# --- Mail (Mailpit in dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Music Room <no-reply@musicroom.local>

# --- Mobile ---
# Default backend URL; use your LAN IP to reach the API from a phone.
EXPO_PUBLIC_API_URL=http://localhost:3000
