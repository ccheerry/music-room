# Copy to .env (git-ignored). The API refuses to start if a required variable is missing.

# --- Postgres (docker compose) ---
POSTGRES_USER=musicroom
POSTGRES_PASSWORD=musicroom
POSTGRES_DB=musicroom

# --- API ---
# Host-side URL (make dev / migrate / test). Inside compose the api uses the `postgres` host.
DATABASE_URL=postgresql://musicroom:musicroom@localhost:5432/musicroom
# Tests use their own database, created and emptied on every run (default: <database>_test).
# TEST_DATABASE_URL=postgresql://musicroom:musicroom@localhost:5432/musicroom_test
PORT=3000
LOG_LEVEL=info
# Signs access tokens, at least 32 characters. Generate one: openssl rand -base64 48
JWT_SECRET=dev-only-secret-replace-me-with-openssl-rand
# Browser origins allowed to call the API (Expo Web), comma-separated.
CORS_ORIGINS=http://localhost:8081

# Requests per minute for one user (or one address when logged out).
RATE_LIMIT_MAX=300
# Login, sign-up and mail requests per 15 minutes for one address.
AUTH_RATE_LIMIT_MAX=30

# --- Mail (Mailpit in dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Music Room <no-reply@musicroom.local>"
# Links in mails open the app. With Expo Go use exp://<lan-ip>:8081/--/
APP_LINK_URL=musicroom://

# --- Social login (optional; the routes answer 503 SOCIAL_DISABLED until set) ---
# Every Google OAuth client id (web, ios, android), comma-separated.
GOOGLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Mobile ---
# Default backend URL; use your LAN IP to reach the API from a phone.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Same ids, read by the app. Leave empty to hide the social buttons.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=
